# Explicitly non-production local defaults. Change every credential outside local development.
POSTGRES_DB=fluxguard
POSTGRES_USER=fluxguard
POSTGRES_PASSWORD=fluxguard_local_only
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://fluxguard:fluxguard_local_only@postgres:5432/fluxguard
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_ORDERS_TOPIC=orders.created.v1
KAFKA_CONSUMER_GROUP=fluxguard-order-projection-v1
LOG_LEVEL=INFO
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
INCIDENT_API_ENABLED=false
FAULT_INJECTION_ENABLED=false
CONSUMER_RETRY_INCIDENT_THRESHOLD=3
OUTBOX_FAILURE_INCIDENT_THRESHOLD=3
INVESTIGATION_API_ENABLED=false
# Select exactly one provider. Provider API keys remain scoped to the investigator container.
LLM_PROVIDER=openrouter
# Set OPENROUTER_API_KEY only in the ignored local .env or process environment. Never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
INVESTIGATION_MODEL_ID=nvidia/nemotron-3.5-super-vl:free
# Gemini Developer API free-tier candidate. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
INVESTIGATION_ALLOW_PAID_MODELS=false
INVESTIGATION_REQUEST_TIMEOUT_SECONDS=30
INVESTIGATION_MAX_RETRIES=2
INVESTIGATION_MAX_LLM_CALLS=4
INVESTIGATION_MAX_ITERATIONS=2
INVESTIGATION_EVIDENCE_LIMIT=50
INVESTIGATION_POLL_INTERVAL_SECONDS=2
