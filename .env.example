# Explicitly non-production local defaults. Change every credential outside local development.
POSTGRES_DB=fluxguard
POSTGRES_USER=fluxguard
POSTGRES_PASSWORD=fluxguard_local_only
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://fluxguard:fluxguard_local_only@postgres:5432/fluxguard
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_ORDERS_TOPIC=orders.created.v1
KAFKA_CONSUMER_GROUP=fluxguard-order-projection-v1
LOG_LEVEL=INFO
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
INCIDENT_API_ENABLED=false
FAULT_INJECTION_ENABLED=false
CONSUMER_RETRY_INCIDENT_THRESHOLD=3
OUTBOX_FAILURE_INCIDENT_THRESHOLD=3
